# The defaults expect sibling checkouts named omarchy, omarchy-iso, and
# omarchy-pkgs. Copy this file to .lab.env and override paths when your layout
# differs. Use absolute paths.
OMARCHY_LAB_SOURCE=/path/to/omarchy
OMARCHY_LAB_ISO_ROOT=/path/to/omarchy-iso
OMARCHY_LAB_PKGS_ROOT=/path/to/omarchy-pkgs
OMARCHY_LAB_ISO=/path/to/omarchy.iso
OMARCHY_LAB_MEMORY=5120
OMARCHY_LAB_SSH_PORT=2222
