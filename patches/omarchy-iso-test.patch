   ssh_session 'for plugin in omarchy.launcher omarchy.menu omarchy.emojis omarchy.clipboard omarchy.audio; do
     omarchy-shell shell hide "$plugin" >/dev/null 2>&1 || true
@@ -1063,6 +1106,49 @@ sync_omarchy() {
   fi
 }
 
+activate_dev_checkout() {
+  $DEV_LINK || return 0
+
+  local target=".local/share/omarchy"
+  log "Linking the disposable guest session to the synced Omarchy checkout"
+
+  ssh_guest "echo '$GUEST_PASSWORD' | sudo -S -v && $target/bin/omarchy-dev-link $target --no-reboot"
+
+  # omarchy-dev-link deliberately leaves the running UWSM environment alone.
+  # A fresh graphical login is enough to rebuild that environment from
+  # /etc/omarchy.conf. Avoid rebooting here: the acceptance disk is already a
+  # throwaway overlay, and some released unencrypted ISOs have a separate
+  # post-install Limine/resume defect that would obscure source-level tests.
+  ssh_guest "uwsm stop" >/dev/null 2>&1 || true
+
+  if ! wait_for_guest_state "linked graphical session stops" 60 session_stopped; then
+    return 1
+  fi
+
+  establish_session
+  ssh_guest "grep -Fq '$target' /etc/omarchy.conf"
+  log "Disposable guest is running entirely from the synced checkout"
+}
+
+run_host_test() {
+  [[ -n $HOST_TEST ]] || return 0
+
+  log "Running host-driven acceptance: $HOST_TEST"
+  # The host test is trusted local test code sourced deliberately so it can use
+  # press, ssh_guest, ssh_session, capture_console, wait_for_guest_state, and
+  # the current RUN_DIR without duplicating the QMP/SSH harness.
+  source "$HOST_TEST"
+  declare -F omarchy_host_test >/dev/null || {
+    echo "$HOST_TEST must define omarchy_host_test()" >&2
+    return 1
+  }
+  set +e
+  omarchy_host_test 2>&1 | tee "$RUN_DIR/host-test.log"
+  local status=${PIPESTATUS[0]}
+  set -e
+  return "$status"
+}
+
 acceptance_phase() {
   log "Booting acceptance VM from base image overlay"
 
