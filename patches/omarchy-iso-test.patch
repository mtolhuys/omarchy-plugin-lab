+  wait_for_guest_state "notification service is ready" 15 \
+    ssh_session "omarchy-shell notifications ping >/dev/null" || return 1
+  ssh_session "omarchy-shell notifications dismissAll >/dev/null" || return 1
+  wait_for_guest_state "startup notifications are dismissed" 15 \
+    guest_layer_absent "omarchy-notifications"
+}
+
