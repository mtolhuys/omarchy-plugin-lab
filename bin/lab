#!/bin/bash

set -euo pipefail

LAB_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
[[ -f $LAB_ROOT/.lab.env ]] && source "$LAB_ROOT/.lab.env"

WORKSPACE_ROOT=$(cd -- "$LAB_ROOT/.." && pwd)
SOURCE_ROOT="${OMARCHY_LAB_SOURCE:-$WORKSPACE_ROOT/omarchy}"
ISO_ROOT="${OMARCHY_LAB_ISO_ROOT:-$WORKSPACE_ROOT/omarchy-iso}"
PKGS_ROOT="${OMARCHY_LAB_PKGS_ROOT:-$WORKSPACE_ROOT/omarchy-pkgs}"
SOURCE_URL="${OMARCHY_LAB_SOURCE_URL:-https://github.com/basecamp/omarchy.git}"
ISO_URL="${OMARCHY_LAB_ISO_URL:-https://github.com/omacom-io/omarchy-iso.git}"
PKGS_URL="${OMARCHY_LAB_PKGS_URL:-https://github.com/omacom-io/omarchy-pkgs.git}"
HARNESS_PATCH="$LAB_ROOT/patches/omarchy-iso-test.patch"
DEFAULT_ISO="$ISO_ROOT/release/omarchy.iso"
if [[ -z ${OMARCHY_LAB_ISO:-} && ! -f $DEFAULT_ISO ]]; then
  DEFAULT_ISO=$(find "$ISO_ROOT/release" -maxdepth 1 -type f -name 'omarchy-*.iso' \
    -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2- || true)
fi
ISO="${OMARCHY_LAB_ISO:-${DEFAULT_ISO:-$ISO_ROOT/release/omarchy.iso}}"
MEMORY="${OMARCHY_LAB_MEMORY:-5120}"
SSH_PORT="${OMARCHY_LAB_SSH_PORT:-2222}"

fail() {
  echo "omarchy-plugin-lab: $*" >&2
  exit 1
}

iso_base_name() {
  basename "$ISO" .iso
}

base_dir() {
  printf '%s/test-runs/%s\n' "$ISO_ROOT" "$(iso_base_name)"
}

base_ready() {
  [[ -f $(base_dir)/base.qcow2 && -f $(base_dir)/.plugin-lab-ready ]]
}

tracked_personal_paths() {
  local pattern
  pattern='/'"home"'/[^/[:space:]]+/|/'"Users"'/[^/[:space:]]+/'
  git -C "$LAB_ROOT" grep -I -n -E "$pattern" -- .
}

clone_checkout() {
  local label=$1 url=$2 branch=$3 destination=$4

  if [[ -e $destination ]]; then
    [[ -d $destination/.git || -f $destination/.git ]] ||
      fail "$label destination exists but is not a Git checkout: $destination"
    echo "keep - $label checkout already exists: $destination"
    return
  fi

  mkdir -p "$(dirname "$destination")"
  echo "clone - $label: $url"
  git clone --branch "$branch" --single-branch "$url" "$destination"
}

harness_supports_lab() {
  local harness=$1
  grep -Eq -- '^[[:space:]]*--dev-link\)' "$harness" &&
    grep -Eq -- '^[[:space:]]*--host-test\)' "$harness" &&
    grep -Eq -- '^[[:space:]]*--host-test-only\)' "$harness" &&
    grep -Eq -- '^[[:space:]]*--discard-overlay\)' "$harness" &&
    grep -Eq -- '^[[:space:]]*--keep-overlay\)' "$harness" &&
    grep -Eq -- '^clear_startup_notifications\(\)' "$harness"
}

ensure_harness_extensions() {
  local harness="$ISO_ROOT/bin/omarchy-iso-test"

  [[ -f $HARNESS_PATCH ]] || fail "Lab harness patch is missing: $HARNESS_PATCH"
  [[ -f $harness ]] || fail "ISO test harness is missing: $harness"
  if harness_supports_lab "$harness"; then
    echo 'keep - ISO harness already provides the plugin-lab extensions'
    return
  fi

  git -C "$ISO_ROOT" diff --quiet && git -C "$ISO_ROOT" diff --cached --quiet ||
    fail "ISO checkout has local changes; refusing to apply the lab harness patch"
  git -C "$ISO_ROOT" apply --check "$HARNESS_PATCH" ||
    fail "The lab harness patch is incompatible with this ISO checkout"
  git -C "$ISO_ROOT" apply "$HARNESS_PATCH"
  echo 'ok - applied the versioned plugin-lab extensions to the ISO harness'
}

download_published_iso() {
  local page iso_url filename target checksum_tmp expected actual

  if [[ -f $ISO ]]; then
    [[ -f $ISO.sha256 ]] || fail "Existing ISO has no checksum sidecar: $ISO"
    (cd "$(dirname "$ISO")" && sha256sum -c "$(basename "$ISO").sha256") ||
      fail 'Existing ISO checksum does not match'
    echo "keep - ISO already exists: $ISO"
    return
  fi

  page=$(curl -fsSL https://omarchy.org) || fail 'Could not read the Omarchy download page'
  iso_url=$(grep -Eo 'https://iso\.omarchy\.org/omarchy-[^"[:space:]]+\.iso' <<<"$page" | head -1 || true)
  [[ -n $iso_url ]] || fail 'Could not discover the published Omarchy ISO URL'
  filename=${iso_url##*/}
  target="$ISO_ROOT/release/$filename"
  mkdir -p "$ISO_ROOT/release"

  echo "download - $iso_url"
  curl -fL --continue-at - --output "$target.part" "$iso_url"
  checksum_tmp=$(mktemp "$ISO_ROOT/release/.${filename}.sha256.XXXXXX")
  if ! curl -fsSL --output "$checksum_tmp" "$iso_url.sha256"; then
    rm -f "$checksum_tmp"
    fail 'Could not download the ISO checksum'
  fi
  expected=$(awk 'NR == 1 { print $1 }' "$checksum_tmp")
  actual=$(sha256sum "$target.part" | awk '{ print $1 }')
  [[ $expected =~ ^[[:xdigit:]]{64}$ && $actual == "$expected" ]] ||
    fail 'Downloaded ISO checksum does not match'
  mv "$target.part" "$target"
  mv "$checksum_tmp" "$target.sha256"
  ISO=$target
  echo "ok - verified published ISO: $ISO"
}

setup_lab() {
  local download_iso=true

  if [[ ${1:-} == "--no-iso" ]]; then
    download_iso=false
    shift
  fi
  (( $# == 0 )) || fail 'Usage: lab setup [--no-iso]'

  command -v git >/dev/null || fail 'Required command is missing: git'
  command -v curl >/dev/null || fail 'Required command is missing: curl'
  command -v sha256sum >/dev/null || fail 'Required command is missing: sha256sum'

  clone_checkout 'Omarchy source' "$SOURCE_URL" quattro "$SOURCE_ROOT"
  clone_checkout 'Omarchy ISO' "$ISO_URL" quattro "$ISO_ROOT"
  clone_checkout 'Omarchy packages' "$PKGS_URL" master "$PKGS_ROOT"
  ensure_harness_extensions
  if $download_iso; then
    download_published_iso
  else
    echo 'skip - published ISO download'
  fi

  printf '\nSetup complete. Next run:\n  ./bin/lab doctor\n'
  $download_iso && printf '  ./bin/lab prepare\n'
}

doctor() {
  local failed=0 cmd

  printf 'Omarchy Plugin Lab\n\n'
  printf '  Source:    %s\n' "$SOURCE_ROOT"
  printf '  ISO repo:  %s\n' "$ISO_ROOT"
  printf '  Packages:  %s\n' "$PKGS_ROOT"
  printf '  ISO:       %s\n' "$ISO"
  printf '  Memory:    %s MiB\n' "$MEMORY"
  printf '  SSH port:  127.0.0.1:%s\n\n' "$SSH_PORT"

  [[ $(uname -m) == "x86_64" ]] || { echo 'not ok - host architecture is not x86_64'; failed=1; }
  [[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]] || { echo 'not ok - /dev/kvm is unavailable'; failed=1; }
  [[ -d $SOURCE_ROOT/.git || -f $SOURCE_ROOT/.git ]] || { echo 'not ok - source checkout is missing'; failed=1; }
  [[ -x $ISO_ROOT/bin/omarchy-iso-test ]] || { echo 'not ok - ISO harness is missing'; failed=1; }
  harness_supports_lab "$ISO_ROOT/bin/omarchy-iso-test" || { echo 'not ok - ISO harness lacks the plugin-lab extensions'; failed=1; }
  [[ -f $ISO ]] || { echo 'not ok - verified Omarchy ISO is missing'; failed=1; }

  for cmd in qemu-system-x86_64 qemu-img socat magick tesseract ssh tar jq git; do
    if ! command -v "$cmd" >/dev/null; then
      echo "not ok - required command is missing: $cmd"
      failed=1
    fi
  done

  if [[ -f $ISO && -f $ISO.sha256 ]]; then
    if (cd "$(dirname "$ISO")" && sha256sum -c "$(basename "$ISO").sha256" >/dev/null); then
      echo 'ok - official ISO checksum matches'
    else
      echo 'not ok - official ISO checksum does not match'
      failed=1
    fi
  else
    echo 'not ok - ISO checksum sidecar is missing'
    failed=1
  fi

  if tracked_personal_paths; then
    echo 'not ok - tracked repository text contains a personal home-directory path'
    failed=1
  else
    echo 'ok - tracked repository text contains no personal home-directory paths'
  fi

  if ((failed)); then
    exit 1
  fi

  echo 'ok - KVM acceleration is available'
  echo 'ok - source, harness, packages, and host tools are ready'
}

prepare() {
  local fresh=false
  if [[ ${1:-} == "--fresh" ]]; then
    fresh=true
    shift
  fi
  (( $# == 0 )) || fail "Usage: lab prepare [--fresh]"

  doctor
  if base_ready && $fresh == false; then
    echo "Reusable base already exists: $(base_dir)/base.qcow2"
    return 0
  fi

  if [[ -d $(base_dir) ]]; then
    if ! $fresh; then
      fail "An incomplete or unverified base exists. Preserve it and retry with: $LAB_ROOT/bin/lab prepare --fresh"
    fi

    local preserved="$(base_dir).replaced.$(date -u +%Y%m%d%H%M%S)"
    mv "$(base_dir)" "$preserved"
    echo "Preserved the previous base and artifacts at: $preserved"
  fi

  "$ISO_ROOT/bin/omarchy-iso-test" "$ISO" \
    --install-only --memory "$MEMORY" --port "$SSH_PORT" --no-preview
  touch "$(base_dir)/.plugin-lab-ready"
}

fast() {
  base_ready || fail "No verified reusable base. Run: $LAB_ROOT/bin/lab prepare"
  export OMARCHY_LAB_PKGS_SOURCE="$PKGS_ROOT"
  export OMARCHY_LAB_ISO_SOURCE="$ISO_ROOT"
  export OMARCHY_LAB_SOURCE_TESTS="$*"
  accept --host-test "$LAB_ROOT/host-tests/repository-suite.sh" --host-test-only
}

accept() {
  base_ready || fail "No verified reusable base. Run: $LAB_ROOT/bin/lab prepare"

  "$ISO_ROOT/bin/omarchy-iso-test" "$ISO" \
    --reuse-base \
    --sync-all "$SOURCE_ROOT" \
    --dev-link \
    --memory "$MEMORY" \
    --port "$SSH_PORT" \
    --no-preview \
    --discard-overlay \
    "$@"
}

accept_host() {
  local host_test="${1:-}"
  [[ -n $host_test ]] || fail "Usage: lab accept-host <host-test-file>"
  [[ $host_test == /* ]] || host_test="$LAB_ROOT/$host_test"
  [[ -f $host_test ]] || fail "Host test not found: $host_test"
  accept --host-test "$host_test"
}

plugin_test() {
  local host_test="${1:-$LAB_ROOT/host-tests/plugin-lifecycle.sh}"
  [[ $host_test == /* ]] || host_test="$LAB_ROOT/$host_test"
  [[ -f $host_test ]] || fail "Plugin test not found: $host_test"
  accept --host-test "$host_test" --host-test-only
}

accept_keep() {
  accept --keep-running
}

shell_guest() {
  local key="$(base_dir)/id_ed25519"
  [[ -f $key ]] || fail "Lab SSH key is missing; prepare the base first"

  exec ssh -i "$key" -p "$SSH_PORT" \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR \
    omarchy@127.0.0.1
}

latest() {
  local run
  run=$(find "$(base_dir)/runs" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null |
    sort -nr | sed -n '1{s/^[^ ]* //;p;}')
  [[ -n $run ]] || fail "No lab runs found"
  printf '%s\n' "$run"
}

human_bytes() {
  local bytes=$1
  if command -v numfmt >/dev/null; then
    numfmt --to=iec-i --suffix=B --format='%.1f' "$bytes"
  else
    printf '%s bytes\n' "$bytes"
  fi
}

overlay_in_use() {
  local overlay=$1 pidfile pid argument

  if command -v fuser >/dev/null && fuser -s "$overlay" 2>/dev/null; then
    return 0
  fi

  pidfile="$(dirname "$overlay")/qemu.pid"
  [[ -r $pidfile ]] || return 1
  read -r pid <"$pidfile" || return 1
  [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/cmdline ]] || return 1

  while IFS= read -r -d '' argument; do
    [[ $argument == *"$overlay"* ]] && return 0
  done <"/proc/$pid/cmdline"
  return 1
}

clean_overlays() {
  local dry_run=false verbose=false overlay bytes=0 removed=0 active=0
  local runs_root="$ISO_ROOT/test-runs"

  while (($#)); do
    case "$1" in
      --dry-run) dry_run=true ;;
      --verbose) verbose=true ;;
      *) fail 'Usage: lab clean [--dry-run] [--verbose]' ;;
    esac
    shift
  done

  if [[ ! -d $runs_root ]]; then
    echo "Nothing to clean: $runs_root does not exist"
    return 0
  fi

  while IFS= read -r -d '' overlay; do
    if overlay_in_use "$overlay"; then
      ((active += 1))
      if $verbose; then
        echo "keep - active VM overlay: $overlay"
      fi
      continue
    fi

    bytes=$((bytes + $(du -B1 -- "$overlay" | awk '{ print $1 }')))
    ((removed += 1))
    if $dry_run; then
      if $verbose; then
        echo "would remove - $overlay"
      fi
    else
      rm -f -- "$overlay"
      [[ ! -e $overlay ]] || fail "Could not remove disposable overlay: $overlay"
      if $verbose; then
        echo "removed - $overlay"
      fi
    fi
  done < <(
    find "$runs_root" -mindepth 4 -maxdepth 4 -type f -name run.qcow2 -print0
  )

  if $dry_run; then
    printf 'Would remove %d stopped disposable VM overlay(s), reclaiming %s.\n' \
      "$removed" "$(human_bytes "$bytes")"
  else
    printf 'Removed %d stopped disposable VM overlay(s), reclaiming %s.\n' \
      "$removed" "$(human_bytes "$bytes")"
  fi
  ((active == 0)) || printf 'Kept %d overlay(s) belonging to an active VM.\n' "$active"
  echo 'Reusable base disks, ISO files, logs, screenshots, and other run evidence were preserved.'
}

status() {
  doctor
  echo
  if base_ready; then
    echo "ok - reusable base: $(base_dir)/base.qcow2"
    qemu-img info "$(base_dir)/base.qcow2" | sed -n '1,8p'
  else
    echo 'pending - no verified reusable base has been prepared'
  fi
  if run=$(latest 2>/dev/null); then
    echo "latest - $run"
  fi
}

build_iso() {
  "$ISO_ROOT/bin/omarchy-iso-make" --no-boot-offer --keep-pkg-cache \
    --local-source "$SOURCE_ROOT" "$PKGS_ROOT"

  local built
  built=$(find "$ISO_ROOT/release" -maxdepth 1 -type f -name '*-local.iso' \
    -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)
  [[ -n $built ]] || fail "The local ISO build finished without an ISO artifact"
  (cd "$(dirname "$built")" && sha256sum "$(basename "$built")" >"$(basename "$built").sha256")
  echo "Local ISO: $built"
  echo "Set OMARCHY_LAB_ISO=$built in .lab.env, then run: ./bin/lab prepare"
}

usage() {
  cat <<USAGE
Usage: ./bin/lab <command>

Commands:
  setup [--no-iso]           Clone dependencies and fetch a verified ISO
  doctor                     Verify host isolation, dependencies, and ISO
  status                     Show lab readiness and reusable base details
  fast [test-files...]       Run all or selected source tests in a fresh VM
  prepare [--fresh]          Create the reusable installed VM base once
  accept [harness-options]   Run a fresh dev-linked disposable VM acceptance
  accept-host <file>         Run host/QMP test plus normal acceptance
  plugin [host-test]         Run a focused plugin test in a fresh VM overlay
  accept-keep                Run acceptance and leave the VM available
  shell                      SSH into a VM left by accept-keep
  latest                     Print the newest evidence directory
  clean [--dry-run] [--verbose]
                             Remove stopped disposable VM overlays, preserving evidence
  build                      Build an ISO from local Omarchy/package sources
USAGE
}

command="${1:-}"
(( $# > 0 )) && shift

case "$command" in
  setup) setup_lab "$@" ;;
  doctor) doctor "$@" ;;
  status) status "$@" ;;
  fast) fast "$@" ;;
  prepare) prepare "$@" ;;
  accept) accept "$@" ;;
  accept-host) accept_host "$@" ;;
  plugin) plugin_test "$@" ;;
  accept-keep) accept_keep "$@" ;;
  shell) shell_guest "$@" ;;
  latest) latest "$@" ;;
  clean) clean_overlays "$@" ;;
  build) build_iso "$@" ;;
  -h|--help|help|'') usage ;;
  *) fail "Unknown command: $command" ;;
esac
