#!/bin/bash

set -euo pipefail

ROOT=${TABLET_PLUGIN_ROOT:?Set TABLET_PLUGIN_ROOT to the staged plugin checkout}
PLUGIN_ID=dev.omarchy.tablet-mode
INSTALLED=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$PLUGIN_ID
EXPECTED=$(jq -er '.version' "$ROOT/manifest.json")
SERVICE_ENTRY=$(jq -er '.entryPoints.service' "$ROOT/manifest.json")
WIDGET_ENTRY=$(jq -er '.entryPoints.barWidget' "$ROOT/manifest.json")

test -d "$INSTALLED/.git"
test "$(jq -er '.version' "$INSTALLED/manifest.json")" = "$EXPECTED"
test "$(git -C "$INSTALLED" rev-parse HEAD)" = "$(git -C "$ROOT" rev-parse HEAD)"
omarchy plugin list --json | jq -e --arg id "$PLUGIN_ID" \
  'any(.[]; .id == $id and .enabled == true)' >/dev/null

STATUS=""
attempt=0
until STATUS=$(omarchy-shell tablet-mode status 2>/dev/null); do
  attempt=$((attempt + 1))
  ((attempt < 25)) || break
  sleep 0.2
done
test -n "$STATUS"
jq -e --arg build "$EXPECTED" '
  .runtimeBuild == $build and
  .widgetBuild == $build and
  (.windowAdjusted | type) == "boolean" and
  .layout == "en-us"
' <<<"$STATUS" >/dev/null

SHELL_PID=$(ps -eo pid=,args= | awk '$0 ~ /quickshell -n -p .*omarchy\/core\/shell/ { print $1; exit }')
if [[ -n "$SHELL_PID" ]]; then
  LOG_LINK=/run/user/$(id -u)/quickshell/by-pid/$SHELL_PID
  LOG_FILE=$(readlink -f "$LOG_LINK")/log.log
  if [[ -f "$LOG_FILE" ]] && grep -E "(service plugin load failed.*${SERVICE_ENTRY}|Plugin widget .* failed:.*${WIDGET_ENTRY})" "$LOG_FILE" >/dev/null; then
    printf 'live verification failed: current runtime entry point appears in the shell error log\n' >&2
    exit 1
  fi
fi

printf 'ok - installed, loaded service, loaded widget, and manifest all report %s\n' "$EXPECTED"
